<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>AutoCache</PackageId>
    <Title>AutoCache</Title>
    <Version>4.0.0-alpha.1</Version>
    <Authors>Naser Yousefi</Authors>
    <Copyright>Copyright © Naser Yousefi</Copyright>
    <Description>Stale-while-revalidate caching for high-throughput .NET applications with single-flight refresh and miss coalescing.</Description>
    <PackageTags>cache;dotnet;stale-while-revalidate;single-flight;cache-stampede;redis;distributed-cache</PackageTags>
    <PackageProjectUrl>https://github.com/n-yousefi/AutoCache</PackageProjectUrl>
    <RepositoryUrl>https://github.com/n-yousefi/AutoCache</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>https://github.com/n-yousefi/AutoCache/releases/tag/v$(Version)</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
